      "source": [
        "# ============================================================\n",
        "# CUSTOMER SEGMENTATION USING CLUSTERING\n",
        "# Google Colab - Python Implementation\n",
        "# ============================================================\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. INSTALL REQUIRED LIBRARIES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "!pip install -q pandas numpy matplotlib seaborn scikit-learn scikit-fuzzy openpyxl scikit-learn-extra\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. IMPORT LIBRARIES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "from sklearn.cluster import (\n",
        "    KMeans,\n",
        "    AgglomerativeClustering,\n",
        "    DBSCAN\n",
        ")\n",
        "\n",
        "from sklearn.mixture import GaussianMixture\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    silhouette_score,\n",
        "    davies_bouldin_score,\n",
        "    calinski_harabasz_score\n",
        ")\n",
        "\n",
        "from sklearn_extra.cluster import KMedoids\n",
        "\n",
        "import skfuzzy as fuzz\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. LOAD CLEANED DATASET\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Your uploaded file name\n",
        "df = pd.read_csv(\"Cleaned_Online_Retail.csv\")\n",
        "\n",
        "print(\"First 5 rows:\")\n",
        "print(df.head())\n",
        "\n",
        "print(\"\\nDataset shape:\")\n",
        "print(df.shape)\n",
        "\n",
        "print(\"\\nDataset information:\")\n",
        "print(df.info())\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. PREPARE DATE AND SALES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Convert InvoiceDate to date format\n",
        "df[\"InvoiceDate\"] = pd.to_datetime(\n",
        "    df[\"InvoiceDate\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "# IMPORTANT:\n",
        "# Convert Quantity and UnitPrice from text to numbers\n",
        "# This fixes the TypeError you received.\n",
        "df[\"Quantity\"] = pd.to_numeric(\n",
        "    df[\"Quantity\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "df[\"UnitPrice\"] = pd.to_numeric(\n",
        "    df[\"UnitPrice\"],\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "# Calculate Total Sales\n",
        "df[\"TotalSales\"] = df[\"Quantity\"] * df[\"UnitPrice\"]\n",
        "\n",
        "# Remove invalid/missing values\n",
        "df = df.dropna(\n",
        "    subset=[\n",
        "        \"CustomerID\",\n",
        "        \"InvoiceDate\",\n",
        "        \"Quantity\",\n",
        "        \"UnitPrice\",\n",
        "        \"TotalSales\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "# Keep only positive Quantity and UnitPrice\n",
        "df = df[\n",
        "    (df[\"Quantity\"] > 0) &\n",
        "    (df[\"UnitPrice\"] > 0)\n",
        "]\n",
        "\n",
        "print(\"\\nShape after cleaning:\")\n",
        "print(df.shape)\n",
        "\n",
        "print(\"\\nSales information:\")\n",
        "print(\n",
        "    df[\n",
        "        [\"Quantity\", \"UnitPrice\", \"TotalSales\"]\n",
        "    ].head()\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 5. RFM FEATURE ENGINEERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Reference date\n",
        "reference_date = (\n",
        "    df[\"InvoiceDate\"].max()\n",
        "    + pd.Timedelta(days=1)\n",
        ")\n",
        "\n",
        "# Create RFM table\n",
        "rfm = df.groupby(\"CustomerID\").agg({\n",
        "    \"InvoiceDate\": lambda x:\n",
        "        (reference_date - x.max()).days,\n",
        "\n",
        "    \"InvoiceNo\": \"nunique\",\n",
        "\n",
        "    \"TotalSales\": \"sum\"\n",
        "}).reset_index()\n",
        "\n",
        "# Rename columns\n",
        "rfm.columns = [\n",
        "    \"CustomerID\",\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"Monetary\"\n",
        "]\n",
        "\n",
        "print(\"\\nRFM Data:\")\n",
        "print(rfm.head())\n",
        "\n",
        "print(\"\\nRFM Shape:\")\n",
        "print(rfm.shape)\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 6. SCALE RFM FEATURES\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "features = [\n",
        "    \"Recency\",\n",
        "    \"Frequency\",\n",
        "    \"Monetary\"\n",
        "]\n",
        "\n",
        "# Select RFM features\n",
        "X = rfm[features].copy()\n",
        "\n",
        "# Log transformation\n",
        "X_log = np.log1p(X)\n",
        "\n",
        "# Standard scaling\n",
        "scaler = StandardScaler()\n",
        "\n",
        "X_scaled = scaler.fit_transform(X_log)\n",
        "\n",
        "print(\"\\nScaled RFM data:\")\n",
        "print(X_scaled[:5])\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 7. PCA VISUALIZATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "pca = PCA(\n",
        "    n_components=2,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "X_pca = pca.fit_transform(X_scaled)\n",
        "\n",
        "print(\"\\nExplained variance:\")\n",
        "print(pca.explained_variance_ratio_)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "\n",
        "plt.scatter(\n",
        "    X_pca[:, 0],\n",
        "    X_pca[:, 1],\n",
        "    alpha=0.5\n",
        ")\n",
        "\n",
        "plt.xlabel(\"PC1\")\n",
        "plt.ylabel(\"PC2\")\n",
        "\n",
        "plt.title(\n",
        "    \"PCA Projection of Customer RFM Features\"\n",
        ")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 8. CHOOSE K USING ELBOW AND SILHOUETTE\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "inertias = []\n",
        "scores = []\n",
        "\n",
        "for k in range(2, 11):\n",
        "\n",
        "    model = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=10\n",
        "    )\n",
        "\n",
        "    labels = model.fit_predict(X_scaled)\n",
        "\n",
        "    inertias.append(\n",
        "        model.inertia_\n",
        "    )\n",
        "\n",
        "    scores.append(\n",
        "        silhouette_score(\n",
        "            X_scaled,\n",
        "            labels\n",
        "        )\n",
        "    )\n",
        "\n",
        "\n",
        "# Elbow Method\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    range(2, 11),\n",
        "    inertias,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"K\")\n",
        "plt.ylabel(\"Inertia\")\n",
        "\n",
        "plt.title(\"Elbow Method\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# Silhouette Analysis\n",
        "plt.figure(figsize=(8, 5))\n",
        "\n",
        "plt.plot(\n",
        "    range(2, 11),\n",
        "    scores,\n",
        "    marker=\"o\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"K\")\n",
        "plt.ylabel(\"Silhouette Score\")\n",
        "\n",
        "plt.title(\"Silhouette Analysis\")\n",
        "\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 9. K-MEANS CLUSTERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Number of clusters\n",
        "k = 4\n",
        "\n",
        "model = KMeans(\n",
        "    n_clusters=k,\n",
        "    random_state=42,\n",
        "    n_init=10\n",
        ")\n",
        "\n",
        "rfm[\"KMeans_Cluster\"] = (\n",
        "    model.fit_predict(X_scaled)\n",
        ")\n",
        "\n",
        "print(\"\\nK-Means Cluster Summary:\")\n",
        "\n",
        "print(\n",
        "    rfm.groupby(\n",
        "        \"KMeans_Cluster\"\n",
        "    )[features].mean()\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 10. HIERARCHICAL / AGGLOMERATIVE CLUSTERING\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model = AgglomerativeClustering(\n",
        "    n_clusters=k,\n",
        "    linkage=\"ward\"\n",
        ")\n",
        "\n",
        "rfm[\"Hierarchical_Cluster\"] = (\n",
        "    model.fit_predict(X_scaled)\n",
        ")\n",
        "\n",
        "print(\"\\nHierarchical Clustering completed.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 11. DBSCAN\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model = DBSCAN(\n",
        "    eps=0.5,\n",
        "    min_samples=5\n",
        ")\n",
        "\n",
        "rfm[\"DBSCAN_Cluster\"] = (\n",
        "    model.fit_predict(X_scaled)\n",
        ")\n",
        "\n",
        "print(\"\\nDBSCAN Cluster Counts:\")\n",
        "\n",
        "print(\n",
        "    rfm[\"DBSCAN_Cluster\"].value_counts()\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 12. GAUSSIAN MIXTURE MODEL (EM)\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model = GaussianMixture(\n",
        "    n_components=k,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "rfm[\"GMM_Cluster\"] = (\n",
        "    model.fit_predict(X_scaled)\n",
        ")\n",
        "\n",
        "print(\"\\nGaussian Mixture Model completed.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 13. K-MEDOIDS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "model = KMedoids(\n",
        "    n_clusters=k,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "rfm[\"KMedoids_Cluster\"] = (\n",
        "    model.fit_predict(X_scaled)\n",
        ")\n",
        "\n",
        "print(\"\\nK-Medoids clustering completed.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 14. FUZZY C-MEANS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Fuzzy C-Means expects data in transposed form\n",
        "data = X_scaled.T\n",
        "\n",
        "cntr, u, _, _, _, _, _ = fuzz.cluster.cmeans(\n",
        "    data,\n",
        "    c=k,\n",
        "    m=2,\n",
        "    error=0.005,\n",
        "    maxiter=1000,\n",
        "    init=None\n",
        ")\n",
        "\n",
        "# Assign each customer to the cluster\n",
        "# with the highest membership value\n",
        "rfm[\"FCM_Cluster\"] = np.argmax(\n",
        "    u,\n",
        "    axis=0\n",
        ")\n",
        "\n",
        "print(\"\\nFuzzy C-Means clustering completed.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 15. EVALUATE AND COMPARE ALGORITHMS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "def evaluate(X, labels, name):\n",
        "\n",
        "    # Remove DBSCAN noise (-1)\n",
        "    mask = labels != -1\n",
        "\n",
        "    Xe = X[mask]\n",
        "    le = labels[mask]\n",
        "\n",
        "    # Need at least two clusters\n",
        "    if len(np.unique(le)) < 2:\n",
        "        return [\n",
        "            name,\n",
        "            np.nan,\n",
        "            np.nan,\n",
        "            np.nan\n",
        "        ]\n",
        "\n",
        "    return [\n",
        "        name,\n",
        "\n",
        "        silhouette_score(\n",
        "            Xe,\n",
        "            le\n",
        "        ),\n",
        "\n",
        "        davies_bouldin_score(\n",
        "            Xe,\n",
        "            le\n",
        "        ),\n",
        "\n",
        "        calinski_harabasz_score(\n",
        "            Xe,\n",
        "            le\n",
        "        )\n",
        "    ]\n",
        "\n",
        "\n",
        "# Calculate evaluation results\n",
        "results = [\n",
        "\n",
        "    evaluate(\n",
        "        X_scaled,\n",
        "        rfm[\"KMeans_Cluster\"].to_numpy(),\n",
        "        \"K-Means\"\n",
        "    ),\n",
        "\n",
        "    evaluate(\n",
        "        X_scaled,\n",
        "        rfm[\"Hierarchical_Cluster\"].to_numpy(),\n",
        "        \"Hierarchical\"\n",
        "    ),\n",
        "\n",
        "    evaluate(\n",
        "        X_scaled,\n",
        "        rfm[\"DBSCAN_Cluster\"].to_numpy(),\n",
        "        \"DBSCAN\"\n",
        "    ),\n",
        "\n",
        "    evaluate(\n",
        "        X_scaled,\n",
        "        rfm[\"GMM_Cluster\"].to_numpy(),\n",
        "        \"Gaussian Mixture\"\n",
        "    ),\n",
        "\n",
        "    evaluate(\n",
        "        X_scaled,\n",
        "        rfm[\"KMedoids_Cluster\"].to_numpy(),\n",
        "        \"K-Medoids\"\n",
        "    ),\n",
        "\n",
        "    evaluate(\n",
        "        X_scaled,\n",
        "        rfm[\"FCM_Cluster\"].to_numpy(),\n",
        "        \"Fuzzy C-Means\"\n",
        "    )\n",
        "]\n",
        "\n",
        "\n",
        "# Create comparison table\n",
        "comparison = pd.DataFrame(\n",
        "    results,\n",
        "    columns=[\n",
        "        \"Algorithm\",\n",
        "        \"Silhouette\",\n",
        "        \"Davies_Bouldin\",\n",
        "        \"Calinski_Harabasz\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"\\nAlgorithm Comparison:\")\n",
        "print(comparison)\n",
        "\n",
        "\n",
        "# Sort by Silhouette Score\n",
        "print(\"\\nSorted Algorithm Comparison:\")\n",
        "\n",
        "print(\n",
        "    comparison.sort_values(\n",
        "        \"Silhouette\",\n",
        "        ascending=False\n",
        "    )\n",
        ")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 16. HYBRID K-MEANS + DBSCAN\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rfm[\"Hybrid_Cluster\"] = -1\n",
        "\n",
        "for cluster_id in sorted(\n",
        "    rfm[\"KMeans_Cluster\"].unique()\n",
        "):\n",
        "\n",
        "    idx = rfm.index[\n",
        "        rfm[\"KMeans_Cluster\"] == cluster_id\n",
        "    ]\n",
        "\n",
        "    X_sub = X_scaled[idx]\n",
        "\n",
        "    if len(X_sub) >= 5:\n",
        "\n",
        "        db = DBSCAN(\n",
        "            eps=0.5,\n",
        "            min_samples=5\n",
        "        )\n",
        "\n",
        "        local = db.fit_predict(X_sub)\n",
        "\n",
        "        for local_id in np.unique(local):\n",
        "\n",
        "            if local_id == -1:\n",
        "                continue\n",
        "\n",
        "            label = (\n",
        "                f\"K{cluster_id}_DB{local_id}\"\n",
        "            )\n",
        "\n",
        "            rfm.loc[\n",
        "                idx[local == local_id],\n",
        "                \"Hybrid_Cluster\"\n",
        "            ] = label\n",
        "\n",
        "\n",
        "print(\"\\nHybrid Clustering completed.\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 17. DISPLAY FINAL CUSTOMER SEGMENTATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "print(\"\\nFinal RFM Customer Segmentation:\")\n",
        "\n",
        "print(rfm.head(20))\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 18. EXPORT RESULTS FOR POWER BI\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "rfm.to_csv(\n",
        "    \"Customer_Segmentation_Results.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "comparison.to_csv(\n",
        "    \"Algorithm_Comparison.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "print(\"\\nExport complete!\")\n",
        "\n",
        "print(\n",
        "    \"\\nCreated files:\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"1. Customer_Segmentation_Results.csv\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"2. Algorithm_Comparison.csv\"\n",
        ")\n",
        "\n",
        "\n",
